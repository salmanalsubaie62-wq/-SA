# ---------------------------------------------------------------
# OMNIA AI — server-side configuration. Never commit real keys.
# A capability is shown as "connected" only when its key is set.
# ---------------------------------------------------------------

# Chat, reasoning, coding, writing, vision (any one provider is enough)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: provider routing order and per-mode model overrides
# OMNIA_PROVIDER_PRIORITY=anthropic,openai,google
# OMNIA_MODEL_ANTHROPIC_REASONING=claude-opus-5-5
# OMNIA_IMAGE_MODEL=gpt-image-1

# Optional: custom API base URLs (proxies or regional endpoints)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# Web research (Brave Search API)
BRAVE_SEARCH_API_KEY=

# Where SQLite database and uploaded/generated files live (default: ./data)
# OMNIA_DATA_DIR=./data
